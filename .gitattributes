# Auto detect text files and perform LF normalization
* text=auto

# Track all files in Artefacts folder with Git LFS
Artefacts/*.pkl filter=lfs diff=lfs merge=lfs -text
Artefacts/*.npy filter=lfs diff=lfs merge=lfs -text
Artefacts/*.safetensors filter=lfs diff=lfs merge=lfs -text
Artefacts/*.bin filter=lfs diff=lfs merge=lfs -text
Artefacts/*.pt filter=lfs diff=lfs merge=lfs -text
Artefacts/*.h5 filter=lfs diff=lfs merge=lfs -text
Artefacts/*.joblib filter=lfs diff=lfs merge=lfs -text
# Also track artifacts in subdirectories
Artefacts/**/*.pkl filter=lfs diff=lfs merge=lfs -text
Artefacts/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
Artefacts/**/*.bin filter=lfs diff=lfs merge=lfs -text
Artefacts/*.json filter=lfs diff=lfs merge=lfs -text
Artefacts/*.txt filter=lfs diff=lfs merge=lfs -text
Artefacts/*.png filter=lfs diff=lfs merge=lfs -text
