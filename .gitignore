# =============================================================================
# NLP Project .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
nlp-bert/

# -----------------------------------------------------------------------------
# Jupyter Notebook
# -----------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# IDEs and Editors
# -----------------------------------------------------------------------------
# PyCharm
.idea/

# VSCode
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# -----------------------------------------------------------------------------
# Machine Learning Specific
# -----------------------------------------------------------------------------
# Large model files (keep organized ones in Artefacts/)
*.pkl
*.joblib
*.h5
*.hdf5
*.safetensors
*.bin
*.onnx
*.tflite

# Exception: Keep organized artifacts (but this is handled by folder structure)
!Artefacts/current/**/*.pkl
!Artefacts/v6.0_educational/**/*.pkl
!Artefacts/shared/**/*.pkl

# Tensorboard logs
runs/
logs/

# Weights & Biases
wandb/

# MLflow
mlruns/

# -----------------------------------------------------------------------------
# Data Files
# -----------------------------------------------------------------------------
# Raw data files (keep curated datasets in Data/)
*.csv
*.json
*.xml
*.txt
*.tsv

# Exception: Keep organized data and documentation
!Data/*.csv
!*.md
!*.txt
!requirements/*.txt

# Large data files
*.parquet
*.feather
*.arrow

# -----------------------------------------------------------------------------
# Output Files
# -----------------------------------------------------------------------------
# Plots and figures (except those in documentation)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf

# Exception: Keep documentation images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# Log files
*.log

# Temporary files
*.tmp
*.temp
temp/
tmp/

# -----------------------------------------------------------------------------
# Environment Variables
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local

# -----------------------------------------------------------------------------
# Configuration Files (with sensitive data)
# -----------------------------------------------------------------------------
config.ini
secrets.json
api_keys.txt

# -----------------------------------------------------------------------------
# Project Specific
# -----------------------------------------------------------------------------
# Experimental notebooks (keep organized ones)
*_experiment_*.ipynb
*_test_*.ipynb
*_scratch_*.ipynb

# Backup files
*.backup
*.bak

# Performance profiling
*.prof

# -----------------------------------------------------------------------------
# Documentation Build
# -----------------------------------------------------------------------------
_build/
.doctrees

# -----------------------------------------------------------------------------
# Compressed Files
# -----------------------------------------------------------------------------
*.zip
*.tar.gz
*.rar
*.7z


